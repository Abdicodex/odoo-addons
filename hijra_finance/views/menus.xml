<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The Customers tab (invoices, credit notes, receivables) is not used by an NGO; the
         transaction tabs take its place in the Accounting menu. -->
    <record id="account.menu_finance_receivables" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <menuitem id="menu_finance_transactions" name="Transactions" parent="account.menu_finance"
              action="finance_transaction_action" sequence="2" groups="group_finance_user"/>
    <menuitem id="menu_finance_expenses" name="Expenses" parent="account.menu_finance"
              action="finance_transaction_expense_action" sequence="2" groups="group_finance_user"/>
    <menuitem id="menu_finance_income" name="Income" parent="account.menu_finance"
              action="finance_transaction_income_action" sequence="2" groups="group_finance_user"/>
    <menuitem id="menu_finance_approvals" name="To Approve" parent="account.menu_finance"
              action="finance_transaction_approval_action" sequence="2"
              groups="group_finance_approver"/>
</odoo>
