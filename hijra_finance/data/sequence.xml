<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- one numbering for payments and receipts, like the paper voucher: SO-CPV00241 -->
    <record id="seq_finance_transaction" model="ir.sequence">
        <field name="name">Finance Transaction</field>
        <field name="code">finance.transaction</field>
        <field name="prefix">SO-CPV</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
