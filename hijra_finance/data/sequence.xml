<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Voucher numbers like the paper vouchers: SO-VPV00001 when the payment is to a vendor,
         SO-CPV00241 for everything else (cash payments, income). -->
    <record id="seq_finance_transaction" model="ir.sequence">
        <field name="name">Finance Transaction (CPV)</field>
        <field name="code">finance.transaction</field>
        <field name="prefix">SO-CPV</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_finance_transaction_vendor" model="ir.sequence">
        <field name="name">Finance Transaction to a Vendor (VPV)</field>
        <field name="code">finance.transaction.vendor</field>
        <field name="prefix">SO-VPV</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
