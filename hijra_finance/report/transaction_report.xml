<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The PDF itself is drawn by report/voucher_pdf.py (see models/ir_actions_report.py),
         so it matches the HIJRA payment voucher template exactly. -->
    <record id="action_report_transaction_voucher" model="ir.actions.report">
        <field name="name">Payment Voucher</field>
        <field name="model">finance.transaction</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hijra_finance.report_transaction_voucher</field>
        <field name="print_report_name">'Voucher - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_finance_transaction"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
