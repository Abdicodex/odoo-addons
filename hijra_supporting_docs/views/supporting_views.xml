<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="supporting_document_type_view_list" model="ir.ui.view">
        <field name="name">supporting.document.type.list</field>
        <field name="model">supporting.document.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="source"/>
                <field name="description"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>
    <record id="supporting_document_type_action" model="ir.actions.act_window">
        <field name="name">Supporting Document Types</field>
        <field name="res_model">supporting.document.type</field>
        <field name="view_mode">list</field>
    </record>

    <record id="expenditure_type_view_list" model="ir.ui.view">
        <field name="name">expenditure.type.list</field>
        <field name="model">expenditure.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="default_account_id" optional="show"/>
            </list>
        </field>
    </record>
    <record id="expenditure_type_view_form" model="ir.ui.view">
        <field name="name">expenditure.type.form</field>
        <field name="model">expenditure.type</field>
        <field name="arch" type="xml">
            <form string="Expenditure Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Vehicle Rental"/></h1>
                    </div>
                    <group>
                        <field name="default_account_id" options="{'no_create': True}"/>
                    </group>
                    <separator string="Supporting documents, in the order they are filed"/>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="document_type_id" options="{'no_create_edit': True}"/>
                            <field name="source" optional="show"/>
                            <field name="requirement"/>
                            <field name="description"/>
                        </list>
                    </field>
                    <p class="text-muted">
                        Standard documents must be present before a payment of this type is posted. Changing the
                        list does not change payments already made; a payment can Refresh Checklist.
                    </p>
                    <field name="note" placeholder="Notes"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="expenditure_type_view_search" model="ir.ui.view">
        <field name="name">expenditure.type.search</field>
        <field name="model">expenditure.type</field>
        <field name="arch" type="xml">
            <search string="Expenditure Types">
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="expenditure_type_action" model="ir.actions.act_window">
        <field name="name">Expenditure Types</field>
        <field name="res_model">expenditure.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="expenditure_type_view_search"/>
    </record>
</odoo>
