<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="customer_type_view_list" model="ir.ui.view">
        <field name="name">customer.type.list</field>
        <field name="model">customer.type</field>
        <field name="arch" type="xml">
            <list string="Customer Types">
                <field name="name"/>
                <field name="description"/>
                <field name="house_count"/>
                <field name="partner_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="customer_type_view_form" model="ir.ui.view">
        <field name="name">customer.type.form</field>
        <field name="model">customer.type</field>
        <field name="arch" type="xml">
            <form string="Customer Types">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_houses" type="object" class="oe_stat_button" icon="fa-home">
    <field name="house_count" widget="statinfo" string="Houses"/>
</button>
                        <button name="action_view_partners" type="object" class="oe_stat_button" icon="fa-users">
    <field name="partner_count" widget="statinfo" string="Customers"/>
</button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="customer_type_view_search" model="ir.ui.view">
        <field name="name">customer.type.search</field>
        <field name="model">customer.type</field>
        <field name="arch" type="xml">
            <search string="Customer Types">
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="customer_type_action" model="ir.actions.act_window">
        <field name="name">Customer Types</field>
        <field name="res_model">customer.type</field>
        <field name="view_mode">list,form</field>
    </record>

