<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_zone_report_view_list" model="ir.ui.view">
        <field name="name">res.zone.report.list</field>
        <field name="model">res.zone.report</field>
        <field name="arch" type="xml">
            <list string="Zone Report" create="0" delete="0">
                <field name="zone_id"/>
                <field name="opening_amount" sum="Total"/>
                <field name="current_month_billed" sum="Total"/>
                <field name="current_month_paid" sum="Total"/>
                <field name="total_due_amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="res_zone_report_view_form" model="ir.ui.view">
        <field name="name">res.zone.report.form</field>
        <field name="model">res.zone.report</field>
        <field name="arch" type="xml">
            <form string="Zone Report" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="zone_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="opening_amount"/>
                            <field name="current_month_billed"/>
                            <field name="current_month_paid"/>
                            <field name="total_due_amount"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_zone_report_view_search" model="ir.ui.view">
        <field name="name">res.zone.report.search</field>
        <field name="model">res.zone.report</field>
        <field name="arch" type="xml">
            <search string="Zone Report">
                <field name="zone_id"/>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="res_zone_report_action" model="ir.actions.act_window">
        <field name="name">Zone Report</field>
        <field name="res_model">res.zone.report</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
