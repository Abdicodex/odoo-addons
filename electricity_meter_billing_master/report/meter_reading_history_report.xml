<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_meter_reading_history" model="ir.actions.report">
        <field name="name">Meter Reading History Report</field>
        <field name="model">meter.reading.history.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">electricity_meter_billing_master.report_meter_reading_history_document</field>
        <field name="print_report_name">'Meter Reading History - %s to %s' % (object.date_from, object.date_to)</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <template id="report_meter_reading_history_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="layout_document_title">Meter Reading History Report</t>
                <t t-call="web.external_layout"
                   company="o.company_id.sudo()"
                   layout_document_title="layout_document_title">
                    <t t-set="lines" t-value="o._get_history()"/>
                    <div class="page">
                        <div class="oe_structure"/>
                        <h2>Meter Reading History Report</h2>
                        <p>
                            <strong>Period:</strong>
                            <span t-field="o.date_from"/> - <span t-field="o.date_to"/>
                            <t t-if="o.env.user.has_group('base.group_multi_company')">
                                &#160;&#160;<strong>Company:</strong> <span t-field="o.company_id"/>
                            </t>
                        </p>
                        <table class="table table-sm table-bordered o_main_table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Supply No.</th>
                                    <th>Customer</th>
                                    <th>Zone</th>
                                    <th>Old Meter</th>
                                    <th>New Meter</th>
                                    <th class="text-end">Previous</th>
                                    <th class="text-end">New</th>
                                    <th class="text-end">Difference</th>
                                    <th>Reason</th>
                                    <th>Updated By</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="lines" t-as="line">
                                    <tr>
                                        <td><span t-field="line.date"/></td>
                                        <td><span t-field="line.house_name"/></td>
                                        <td><span t-field="line.partner_id"/></td>
                                        <td><span t-field="line.zone_id"/></td>
                                        <td><span t-field="line.meter_number"/></td>
                                        <td><span t-field="line.new_meter_number"/></td>
                                        <td class="text-end"><span t-field="line.previous_reading"/></td>
                                        <td class="text-end"><span t-field="line.new_reading"/></td>
                                        <td class="text-end"><span t-field="line.difference"/></td>
                                        <td><span t-field="line.reason_id"/></td>
                                        <td><span t-field="line.user_id"/></td>
                                    </tr>
                                </t>
                                <tr t-if="not lines">
                                    <td colspan="11" class="text-center text-muted">
                                        No meter readings were updated in this period.
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot t-if="lines">
                                <tr class="fw-bold">
                                    <td colspan="8">Total consumption (sum of differences)</td>
                                    <td class="text-end"><t t-out="sum(lines.mapped('difference'))"
                                        t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td colspan="2"><t t-out="len(lines)"/> readings</td>
                                </tr>
                            </tfoot>
                        </table>
                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
