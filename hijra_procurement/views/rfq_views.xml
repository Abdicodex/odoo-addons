<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_request_rfq_view_form_committee" model="ir.ui.view">
        <field name="name">purchase.request.rfq.form.committee</field>
        <field name="model">purchase.request.rfq</field>
        <field name="inherit_id" ref="purchase_request_rfq.purchase_request_rfq_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_cancel']" position="before">
                <button name="action_start_session" string="Start Committee Session" type="object"
                        class="oe_highlight"
                        invisible="state != 'open' or committee_state != 'pending' or not committee_required"
                        groups="purchase.group_purchase_user"/>
                <button name="action_generate_minutes" string="Draft Minutes" type="object"
                        invisible="committee_state != 'session'"
                        groups="purchase.group_purchase_user"/>
                <button name="action_reset_session" string="Reset Session" type="object"
                        invisible="committee_state == 'pending' or state != 'open'"
                        groups="purchase.group_purchase_manager"
                        confirm="All signatures of this session will be removed. Continue?"/>
            </xpath>
            <xpath expr="//page[@name='comparison']" position="after">
                <page string="Committee" name="committee" invisible="not committee_required">
                    <group>
                        <group string="Requirement" name="requirement">
                            <field name="band_id"/>
                            <field name="procurement_amount"/>
                            <label for="invited_count" string="Vendors Invited"/>
                            <div class="o_row">
                                <field name="invited_count"/>
                                <span class="text-muted">of at least</span>
                                <field name="min_invitations"/>
                            </div>
                            <label for="quotes_count" string="Quotes Received"/>
                            <div class="o_row">
                                <field name="quotes_count"/>
                                <span class="text-muted">of at least</span>
                                <field name="min_quotes"/>
                            </div>
                            <field name="shortfall" invisible="1"/>
                            <field name="shortfall_justification" invisible="not shortfall"
                                   readonly="committee_state != 'pending'"/>
                        </group>
                        <group string="Meeting" name="meeting">
                            <field name="committee_state" widget="badge"
                                   decoration-info="committee_state == 'session'"
                                   decoration-success="committee_state == 'decided'"/>
                            <field name="committee_id" readonly="committee_state != 'pending'"
                                   options="{'no_create': True}"/>
                            <field name="meeting_date" readonly="committee_state == 'decided'"/>
                            <label for="meeting_start" string="Time"/>
                            <div class="o_row">
                                <field name="meeting_start" widget="float_time"
                                       readonly="committee_state == 'decided'"/>
                                <span class="text-muted">to</span>
                                <field name="meeting_end" widget="float_time"
                                       readonly="committee_state == 'decided'"/>
                            </div>
                            <field name="observer_required" invisible="1"/>
                            <field name="observer_name" invisible="not observer_required"
                                   readonly="committee_state != 'pending'"
                                   placeholder="Representative invited"/>
                            <field name="observer_organization" invisible="not observer_required"
                                   readonly="committee_state != 'pending'"/>
                        </group>
                    </group>
                    <group string="Decision" name="decision">
                        <field name="recommended_order_id" options="{'no_create': True}"
                               readonly="committee_state == 'decided'"/>
                        <field name="recommendation_reason" readonly="committee_state == 'decided'"/>
                        <field name="selection_criteria" readonly="committee_state == 'decided'"/>
                        <field name="agenda" readonly="committee_state == 'decided'"/>
                    </group>
                    <separator string="Minutes"/>
                    <field name="minutes_text" nolabel="1" readonly="committee_state == 'decided'"
                           placeholder="Press Draft Minutes to write them from the quotations and the selection."/>
                    <separator string="Signatures"/>
                    <field name="signoff_ids" nolabel="1">
                        <list create="0" delete="0" edit="0" decoration-success="signed_date"
                              default_order="document, sequence">
                            <field name="document"/>
                            <field name="user_id"/>
                            <field name="signed_date"/>
                            <field name="can_sign" column_invisible="True"/>
                            <button name="action_sign" type="object" string="Sign" icon="fa-pencil"
                                    class="text-primary" invisible="not can_sign"/>
                        </list>
                    </field>
                    <p class="text-muted">
                        Each member signs the declaration first; the bid analysis, the statement and the
                        minutes follow once the recommended vendor is chosen. When everyone has signed, the
                        committee has decided and the vendor can be awarded.
                    </p>
                </page>
            </xpath>
        </field>
    </record>

    <record id="purchase_request_rfq_view_list_committee" model="ir.ui.view">
        <field name="name">purchase.request.rfq.list.committee</field>
        <field name="model">purchase.request.rfq</field>
        <field name="inherit_id" ref="purchase_request_rfq.purchase_request_rfq_view_list"/>
        <field name="arch" type="xml">
            <field name="awarded_partner_id" position="after">
                <field name="band_id" optional="show"/>
                <field name="committee_state" widget="badge" optional="show"
                       decoration-info="committee_state == 'session'"
                       decoration-success="committee_state == 'decided'"/>
            </field>
        </field>
    </record>

    <record id="purchase_request_rfq_committee_action" model="ir.actions.act_window">
        <field name="name">Committee Sessions</field>
        <field name="res_model">purchase.request.rfq</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('band_id.committee_required', '=', True)]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No RFQ needs the committee</p>
            <p>RFQs of 500 or more come here. Start the session once the vendors' prices are in.</p>
        </field>
    </record>
</odoo>
