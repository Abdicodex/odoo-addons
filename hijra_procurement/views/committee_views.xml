<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="procurement_committee_view_list" model="ir.ui.view">
        <field name="name">procurement.committee.list</field>
        <field name="model">procurement.committee</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="review_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="procurement_committee_view_form" model="ir.ui.view">
        <field name="name">procurement.committee.form</field>
        <field name="model">procurement.committee</field>
        <field name="arch" type="xml">
            <form string="Procurement Committee">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="review_date"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <separator string="Members"/>
                    <field name="member_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="user_id" options="{'no_create': True}"/>
                            <field name="full_name"/>
                            <field name="role"/>
                            <field name="position" placeholder="e.g. Finance Officer"/>
                        </list>
                    </field>
                    <p class="text-muted">
                        The committee is fixed and reviewed yearly. Every member signs the documents of
                        each session with the signature on their employee profile.
                    </p>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="procurement_committee_action" model="ir.actions.act_window">
        <field name="name">Committee</field>
        <field name="res_model">procurement.committee</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
