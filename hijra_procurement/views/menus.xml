<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The Purchase app: My Work | Requisitions | Procurement | Committee | Vendors | ... -->
    <record id="purchase.menu_purchase_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('group_procurement_committee'))]"/>
    </record>

    <menuitem id="menu_procurement_my_work" name="My Work" parent="purchase.menu_purchase_root"
              action="procurement_file_my_work_action" sequence="10"/>

    <!-- Procurement: the buyer's, finance's and the administrators' screens -->
    <menuitem id="menu_procurement_group" name="Procurement" parent="purchase.menu_purchase_root"
              sequence="30" groups="purchase.group_purchase_user,group_procurement_committee,base.group_system"/>
    <menuitem id="menu_procurement_files" name="Procurement Files" parent="menu_procurement_group"
              action="procurement_file_action" sequence="10"/>
    <record id="purchase.menu_purchase_rfq" model="ir.ui.menu">
        <field name="parent_id" ref="menu_procurement_group"/>
        <field name="sequence">20</field>
    </record>
    <record id="purchase.menu_purchase_form_action" model="ir.ui.menu">
        <field name="parent_id" ref="menu_procurement_group"/>
        <field name="sequence">30</field>
    </record>

    <!-- Committee -->
    <menuitem id="menu_procurement_root" name="Committee" parent="purchase.menu_purchase_root"
              sequence="40" groups="group_procurement_committee,purchase.group_purchase_user,base.group_system"/>
    <menuitem id="menu_procurement_sessions" name="Committee Sessions" parent="menu_procurement_root"
              action="purchase_request_rfq_committee_action" sequence="10"/>

    <!-- Vendors get their own tab; the old Orders menu is empty now -->
    <record id="purchase.menu_procurement_management_supplier_name" model="ir.ui.menu">
        <field name="parent_id" ref="purchase.menu_purchase_root"/>
        <field name="sequence">50</field>
    </record>
    <record id="purchase.menu_procurement_management" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- the settings live in the Purchase Configuration menu -->
    <menuitem id="menu_procurement_committee" name="Committee" parent="purchase.menu_purchase_config"
              action="procurement_committee_action" sequence="40"/>
    <menuitem id="menu_procurement_bands" name="Procurement Bands" parent="purchase.menu_purchase_config"
              action="procurement_band_action" sequence="41"/>
</odoo>
