<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Every document of the file in one PDF, from the requisition to the payment voucher. -->
    <record id="action_report_procurement_file" model="ir.actions.report">
        <field name="name">All Documents</field>
        <field name="model">procurement.file</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hijra_procurement.report_procurement_file</field>
        <field name="print_report_name">'Procurement File - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_procurement_file"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
