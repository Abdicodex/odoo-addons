<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="procurement_grn_view_list" model="ir.ui.view">
        <field name="name">procurement.grn.list</field>
        <field name="model">procurement.grn</field>
        <field name="arch" type="xml">
            <list string="Goods Received Notes" decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'checked'">
                <field name="name"/>
                <field name="date"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="order_complete" optional="show"/>
                <field name="invoice_number" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'received'" decoration-success="state == 'checked'"/>
            </list>
        </field>
    </record>

    <record id="procurement_grn_view_form" model="ir.ui.view">
        <field name="name">procurement.grn.form</field>
        <field name="model">procurement.grn</field>
        <field name="arch" type="xml">
            <form string="Goods Received Note">
                <header>
                    <button name="action_receive" string="Mark as Received" type="object" class="oe_highlight"
                            invisible="state != 'draft'" groups="purchase.group_purchase_user"/>
                    <button name="action_check" string="Check" type="object" class="oe_highlight"
                            invisible="state != 'received'"/>
                    <button name="%(hijra_receipts.action_report_grn)d" string="Print" type="action"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('checked', 'cancelled')" groups="purchase.group_purchase_user"/>
                    <button name="action_reset_draft" string="Set to Draft" type="object"
                            invisible="state != 'cancelled'" groups="purchase.group_purchase_user"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,received,checked"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label">Goods Received Note</span>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="order_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="partner_id"/>
                            <field name="project_id"/>
                            <field name="budget_id"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="location" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="invoice_number" readonly="state not in ('draft', 'received')"/>
                            <field name="doc_invoice" readonly="state not in ('draft', 'received')"/>
                            <field name="doc_delivery" readonly="state not in ('draft', 'received')"/>
                            <field name="order_complete" widget="radio" readonly="state != 'draft'"/>
                            <field name="shipment" widget="radio" readonly="state != 'draft'"/>
                            <field name="checked_by_id" widget="many2one_avatar_user"
                                   readonly="state not in ('draft', 'received')"/>
                        </group>
                    </group>
                    <separator string="Items"/>
                    <field name="line_ids" nolabel="1" readonly="state != 'draft'">
                        <list editable="bottom" create="0" delete="0">
                            <field name="sequence" widget="handle"/>
                            <field name="order_line_id" column_invisible="True"/>
                            <field name="description" readonly="1"/>
                            <field name="uom" readonly="1"/>
                            <field name="qty_ordered" readonly="1"/>
                            <field name="qty_previous" readonly="1" optional="show"/>
                            <field name="qty_received"/>
                            <field name="comment"/>
                        </list>
                    </field>
                    <group>
                        <group>
                            <field name="received_by_id"/>
                            <field name="received_date" groups="!purchase.group_purchase_manager"/>
                            <field name="received_date" readonly="0" groups="purchase.group_purchase_manager"/>
                        </group>
                        <group>
                            <field name="checked_date" groups="!purchase.group_purchase_manager"/>
                            <field name="checked_date" readonly="0" groups="purchase.group_purchase_manager"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="procurement_grn_view_search" model="ir.ui.view">
        <field name="name">procurement.grn.search</field>
        <field name="model">procurement.grn</field>
        <field name="arch" type="xml">
            <search string="Goods Received Notes">
                <field name="name"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="invoice_number"/>
                <filter name="to_check" string="To Check" domain="[('state', '=', 'received')]"/>
                <filter name="checked" string="Checked" domain="[('state', '=', 'checked')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="Vendor" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="procurement_grn_action" model="ir.actions.act_window">
        <field name="name">Goods Received Notes</field>
        <field name="res_model">procurement.grn</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="procurement_grn_view_search"/>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No goods received yet</p>
            <p>Open a confirmed purchase order and press Receive Goods.</p>
        </field>
    </record>
</odoo>
