<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_view_form_receipts" model="ir.ui.view">
        <field name="name">purchase.order.form.receipts</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <field name="can_receive_goods" invisible="1"/>
                <field name="can_complete_service" invisible="1"/>
                <button name="action_receive_goods" string="Receive Goods" type="object"
                        class="oe_highlight" invisible="not can_receive_goods"
                        groups="purchase.group_purchase_user"/>
                <button name="action_complete_service" string="Completion Note" type="object"
                        invisible="not can_complete_service" groups="purchase.group_purchase_user"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_grns" type="object" class="oe_stat_button" icon="fa-truck"
                        invisible="grn_count == 0">
                    <div class="o_stat_info">
                        <field name="grn_count" class="o_stat_value"/>
                        <span class="o_stat_text">Goods Received</span>
                    </div>
                </button>
                <button name="action_view_completions" type="object" class="oe_stat_button" icon="fa-check-square-o"
                        invisible="completion_count == 0">
                    <div class="o_stat_info">
                        <field name="completion_count" class="o_stat_value"/>
                        <span class="o_stat_text">Completion Notes</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
