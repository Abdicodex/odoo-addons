<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_view_form_receipts" model="ir.ui.view">
        <field name="name">purchase.order.form.receipts</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- the standard Receive button (action_receive) opens the receipt document; see the model -->
            <field name="partner_ref" position="after">
                <field name="receipt_locked" invisible="1"/>
                <field name="receipt_type" widget="radio" options="{'horizontal': true}"
                       readonly="receipt_locked"/>
            </field>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_grns" type="object" class="oe_stat_button" icon="fa-truck"
                        invisible="grn_count == 0">
                    <div class="o_stat_info">
                        <field name="grn_count" class="o_stat_value"/>
                        <span class="o_stat_text">Goods Received</span>
                    </div>
                </button>
                <button name="action_view_completions" type="object" class="oe_stat_button" icon="fa-check-square-o"
                        invisible="completion_count == 0">
                    <div class="o_stat_info">
                        <field name="completion_count" class="o_stat_value"/>
                        <span class="o_stat_text">Completion Notes</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
