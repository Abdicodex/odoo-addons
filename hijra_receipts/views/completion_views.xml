<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="procurement_completion_view_list" model="ir.ui.view">
        <field name="name">procurement.completion.list</field>
        <field name="model">procurement.completion</field>
        <field name="arch" type="xml">
            <list string="Service Completion Notes" decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'approved'">
                <field name="name"/>
                <field name="date"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="service" optional="show"/>
                <field name="approver_id" widget="many2one_avatar_user" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>

    <record id="procurement_completion_view_form" model="ir.ui.view">
        <field name="name">procurement.completion.form</field>
        <field name="model">procurement.completion</field>
        <field name="arch" type="xml">
            <form string="Service Completion Note">
                <header>
                    <button name="action_draft_text" string="Draft Note" type="object"
                            invisible="state != 'draft'" groups="purchase.group_purchase_user"
                            confirm="This rewrites the background and the conclusion from the details above. Continue?"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="%(hijra_receipts.action_report_completion)d" string="Print" type="action"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('approved', 'cancelled')" groups="purchase.group_purchase_user"/>
                    <button name="action_reset_draft" string="Set to Draft" type="object"
                            invisible="state != 'cancelled'" groups="purchase.group_purchase_user"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label">Service Completion Note</span>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="order_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="partner_id"/>
                            <field name="project_id"/>
                            <field name="budget_id"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="approver_id" widget="many2one_avatar_user" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="service" readonly="state != 'draft'"
                                   placeholder="e.g. refreshments and lunch for 200 participants"/>
                            <field name="activity" readonly="state != 'draft'"
                                   placeholder="e.g. Agricultural Training for Smallholder Farmers"/>
                            <field name="place" readonly="state != 'draft'"/>
                            <field name="activity_dates" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <separator string="Background"/>
                    <field name="background" nolabel="1" readonly="state != 'draft'"/>
                    <separator string="Key Benefits of the Activity (one per line)"/>
                    <field name="benefits" nolabel="1" readonly="state != 'draft'"
                           placeholder="Strengthened the practical skills of ..."/>
                    <separator string="Conclusion"/>
                    <field name="conclusion" nolabel="1" readonly="state != 'draft'"/>
                    <group>
                        <field name="approver_date" groups="!purchase.group_purchase_manager"/>
                        <field name="approver_date" readonly="0" groups="purchase.group_purchase_manager"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="procurement_completion_view_search" model="ir.ui.view">
        <field name="name">procurement.completion.search</field>
        <field name="model">procurement.completion</field>
        <field name="arch" type="xml">
            <search string="Service Completion Notes">
                <field name="name"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="Vendor" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="procurement_completion_action" model="ir.actions.act_window">
        <field name="name">Service Completion Notes</field>
        <field name="res_model">procurement.completion</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="procurement_completion_view_search"/>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No service completion notes yet</p>
            <p>Open a confirmed purchase order for a service and press Completion Note.</p>
        </field>
    </record>
</odoo>
