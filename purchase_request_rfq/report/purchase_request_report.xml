<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_purchase_request" model="ir.actions.report">
        <field name="name">Purchase Requisition Form</field>
        <field name="model">purchase.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">purchase_request_rfq.report_purchase_request</field>
        <field name="print_report_name">'Purchase Requisition - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_purchase_request"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_purchase_request_document">
        <t t-call="web.basic_layout">
            <t t-set="o" t-value="o.with_context(lang=o.requester_id.lang)"/>
            <div class="page" style="font-size: 12px;">
                <style>
                    table.prf { width: 100%; border-collapse: collapse; margin-bottom: 10px; }
                    table.prf td, table.prf th { border: 1px solid #000; padding: 4px 6px; vertical-align: middle; }
                    table.prf .lbl { background-color: #f2f2f2; font-weight: bold; }
                    table.prf .band { background-color: #f2f2f2; font-weight: bold; font-size: 13px; }
                    table.prf th { background-color: #f2f2f2; font-weight: bold; text-align: center; }
                    table.prf-head td { border: none; padding: 0; vertical-align: middle; }
                </style>

                <!-- Title and logo -->
                <table class="prf-head" style="width: 100%; margin-bottom: 10px;">
                    <tr>
                        <td style="font-size: 26px; font-weight: bold;">Purchase Requisition Form</td>
                        <td style="text-align: right; width: 30%;">
                            <img t-if="o.company_id.logo"
                                 t-att-src="image_data_uri(o.company_id.logo)"
                                 style="max-height: 80px; max-width: 100%;" alt="Logo"/>
                        </td>
                    </tr>
                </table>

                <!-- PRF number and date -->
                <table class="prf" style="width: 50%;">
                    <tr>
                        <td class="lbl" style="width: 30%;">PRF</td>
                        <td><span t-field="o.name"/></td>
                    </tr>
                    <tr>
                        <td class="lbl">Date:</td>
                        <td><span t-field="o.date_request" t-options='{"widget": "date"}'/></td>
                    </tr>
                </table>

                <!-- Requisition details -->
                <table class="prf">
                    <tr><td colspan="4" class="band">Requisition Details</td></tr>
                    <tr>
                        <td class="lbl" style="width: 18%;">Requestor</td>
                        <td style="width: 32%;"><span t-field="o.requester_id"/></td>
                        <td class="lbl" style="width: 18%;">Project</td>
                        <td style="width: 32%;"><span t-field="o.project_id.code"/></td>
                    </tr>
                    <tr>
                        <td class="lbl">Position</td>
                        <td><span t-field="o.requester_position"/></td>
                        <td class="lbl">Budget</td>
                        <td><span t-field="o.budget_id.code"/></td>
                    </tr>
                    <tr>
                        <td class="lbl">Department</td>
                        <td><span t-field="o.department_id.name"/></td>
                        <td class="lbl">Fund</td>
                        <td><span t-field="o.fund_id.code"/></td>
                    </tr>
                    <tr>
                        <td class="lbl">Location</td>
                        <td><span t-field="o.location_id.code"/></td>
                        <td class="lbl">Category</td>
                        <td><span t-field="o.category"/></td>
                    </tr>
                    <tr>
                        <td class="lbl">Email</td>
                        <td><span t-field="o.requester_email"/></td>
                        <td class="lbl">Verifier</td>
                        <td><span t-field="o.verifier_id"/></td>
                    </tr>
                    <tr style="height: 50px;">
                        <td class="lbl">Requestor's Signature</td>
                        <td></td>
                        <td class="lbl">Verifier's Signature</td>
                        <td></td>
                    </tr>
                </table>

                <!-- Item details -->
                <table class="prf">
                    <tr><td colspan="7" class="band">Item Details</td></tr>
                    <tr>
                        <th style="width: 8%;">Item #</th>
                        <th style="width: 36%;">Description</th>
                        <th style="width: 10%;">Unit</th>
                        <th style="width: 10%;">Quantity</th>
                        <th style="width: 10%;">Frequency</th>
                        <th style="width: 12%;">Unit Price</th>
                        <th style="width: 14%;">Amount</th>
                    </tr>
                    <t t-foreach="o.line_ids.sorted('sequence')" t-as="line">
                        <tr>
                            <td class="text-center"><t t-out="line_index + 1"/></td>
                            <td><span t-field="line.description"/></td>
                            <td class="text-center"><span t-field="line.unit"/></td>
                            <td class="text-end"><span t-field="line.product_qty"/></td>
                            <td class="text-end"><span t-field="line.frequency"/></td>
                            <td class="text-end">
                                <span t-field="line.price_unit"
                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                            <td class="text-end">
                                <span t-field="line.subtotal"
                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                    </t>
                    <tr>
                        <td colspan="6" class="lbl">Total Amount</td>
                        <td class="text-end" style="font-weight: bold;">
                            <span t-field="o.amount_total"
                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </td>
                    </tr>
                </table>

                <!-- Approval -->
                <table class="prf">
                    <tr>
                        <td class="lbl" style="width: 24%;">Name of Approver:</td>
                        <td style="width: 28%;"><span t-field="o.approver_id"/></td>
                        <td class="lbl" style="width: 14%;">Signature:</td>
                        <td style="width: 34%; height: 40px;">
                            <span t-if="o.approval_date" style="font-size: 10px; color: #555;">Approved electronically</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="lbl">Position:</td>
                        <td><span t-field="o.approver_position"/></td>
                        <td class="lbl">Date:</td>
                        <td>
                            <span t-if="o.approval_date" t-field="o.approval_date"
                                  t-options='{"widget": "date"}'/>
                        </td>
                    </tr>
                </table>

                <table class="prf">
                    <tr>
                        <td class="lbl" style="width: 24%;">2nd Signatory (if required):</td>
                        <td style="width: 28%;"><span t-field="o.second_signatory_id"/></td>
                        <td class="lbl" style="width: 14%;">Signature:</td>
                        <td style="width: 34%; height: 40px;">
                            <span t-if="o.second_approval_date" style="font-size: 10px; color: #555;">Approved electronically</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="lbl">Position:</td>
                        <td><span t-field="o.second_position"/></td>
                        <td class="lbl">Date:</td>
                        <td>
                            <span t-if="o.second_approval_date" t-field="o.second_approval_date"
                                  t-options='{"widget": "date"}'/>
                        </td>
                    </tr>
                </table>
            </div>
        </t>
    </template>

    <template id="report_purchase_request">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="purchase_request_rfq.report_purchase_request_document"
                   t-lang="o.requester_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
