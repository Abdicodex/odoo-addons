<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_purchase_request" model="ir.actions.report">
        <field name="name">Purchase Request</field>
        <field name="model">purchase.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">purchase_request_rfq.report_purchase_request</field>
        <field name="report_file">purchase_request_rfq.report_purchase_request</field>
        <field name="print_report_name">'Purchase Request - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_purchase_request"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_purchase_request_document">
        <t t-set="address">
            <div t-field="o.partner_id"
                 t-options='{"widget": "contact", "fields": ["address", "name", "phone", "vat"], "no_marker": True, "phone_icons": True}'/>
        </t>
        <t t-set="layout_document_title">
            <span>Purchase Request <span t-field="o.name"/></span>
        </t>
        <t t-call="web.external_layout"
           company="o.company_id.sudo()"
           address="address"
           layout_document_title="layout_document_title">
            <div class="page">
                <div class="oe_structure"/>
                <div id="informations" class="row mt-4 mb-4">
                    <div t-if="o.requester_id" class="col-3 mb-2">
                        <strong>Requested By:</strong>
                        <p class="m-0" t-field="o.requester_id"/>
                    </div>
                    <div t-if="o.date_request" class="col-3 mb-2">
                        <strong>Request Date:</strong>
                        <p class="m-0" t-field="o.date_request" t-options='{"widget": "date"}'/>
                    </div>
                    <div t-if="o.date_required" class="col-3 mb-2">
                        <strong>Expected Arrival:</strong>
                        <p class="m-0" t-field="o.date_required"/>
                    </div>
                    <div t-if="o.user_id" class="col-3 mb-2">
                        <strong>Buyer:</strong>
                        <p class="m-0" t-field="o.user_id"/>
                    </div>
                    <div t-if="o.origin" class="col-3 mb-2">
                        <strong>Source:</strong>
                        <p class="m-0" t-field="o.origin"/>
                    </div>
                    <div t-if="o.partner_ref" class="col-3 mb-2">
                        <strong>Vendor Reference:</strong>
                        <p class="m-0" t-field="o.partner_ref"/>
                    </div>
                    <div t-if="o.payment_term_id" class="col-3 mb-2">
                        <strong>Payment Terms:</strong>
                        <p class="m-0" t-field="o.payment_term_id"/>
                    </div>
                    <div class="col-3 mb-2">
                        <strong>Status:</strong>
                        <p class="m-0" t-field="o.state"/>
                    </div>
                </div>

                <table class="table table-borderless">
                    <thead style="display: table-row-group">
                        <tr>
                            <th name="th_description"><strong>Description</strong></th>
                            <th name="th_taxes"><strong>Taxes</strong></th>
                            <th name="th_date_req" class="text-center"><strong>Expected Date</strong></th>
                            <th name="th_quantity" class="text-end"><strong>Qty</strong></th>
                            <th name="th_price_unit" class="text-end"><strong>Unit Price</strong></th>
                            <th name="th_subtotal" class="text-end"><strong>Amount</strong></th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.line_ids" t-as="line">
                            <tr>
                                <td id="product"><span t-field="line.description"/></td>
                                <td name="td_taxes">
                                    <span t-out="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))"/>
                                </td>
                                <td class="text-center">
                                    <span t-field="line.date_planned" t-options="{'date_only': 'true'}"/>
                                </td>
                                <td class="text-end">
                                    <span t-field="line.product_qty"/>
                                    <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                </td>
                                <td class="text-end">
                                    <span t-field="line.price_unit"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                                <td class="text-end">
                                    <span t-field="line.subtotal"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div id="total" class="row justify-content-end">
                    <div class="col-4">
                        <table class="table table-sm table-borderless">
                            <tr>
                                <td><strong>Untaxed Amount</strong></td>
                                <td class="text-end">
                                    <span t-field="o.amount_untaxed"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                            <tr>
                                <td>Taxes</td>
                                <td class="text-end">
                                    <span t-field="o.amount_tax"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                            <tr class="border-top">
                                <td><strong>Total</strong></td>
                                <td class="text-end">
                                    <strong>
                                        <span t-field="o.amount_total"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </strong>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div t-if="o.reason" class="mt-3">
                    <strong>Justification:</strong>
                    <p t-field="o.reason"/>
                </div>
                <p t-field="o.note" class="mt-4"/>

                <div t-if="o.approver_id and o.state in ('approved', 'rfq_created')" class="mt-4">
                    <strong>Approved by:</strong>
                    <span t-field="o.approver_id"/> -
                    <span t-field="o.decision_date"/>
                </div>
                <div t-else="" class="mt-5 row">
                    <div class="col-6">
                        <p class="border-top pt-1 mb-0">Requested by (signature)</p>
                    </div>
                    <div class="col-6">
                        <p class="border-top pt-1 mb-0">Approved by (signature)</p>
                    </div>
                </div>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <template id="report_purchase_request">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="purchase_request_rfq.report_purchase_request_document"
                   t-lang="o.requester_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
