<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_request_view_list" model="ir.ui.view">
        <field name="name">purchase.request.list</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <list string="Purchase Requests" decoration-info="state == 'to_approve'"
                  decoration-success="state == 'approved'"
                  decoration-muted="state in ('cancelled', 'rejected')">
                <field name="priority" optional="show" widget="priority" nolabel="1"/>
                <field name="name" string="Reference"/>
                <field name="date_request" optional="show"/>
                <field name="requester_id" widget="many2one_avatar_user"/>
                <field name="partner_id" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="origin" optional="hide"/>
                <field name="date_required" optional="show"/>
                <field name="amount_total" sum="Total" widget="monetary" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'to_approve'"
                       decoration-success="state in ('approved', 'rfq_created')"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="purchase_request_view_form" model="ir.ui.view">
        <field name="name">purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <form string="Purchase Request">
                <header>
                    <button name="action_request_approval" string="Request Approval" type="object"
                            class="oe_highlight" invisible="state != 'draft'" data-hotkey="g"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="oe_highlight" invisible="state != 'to_approve'"
                            groups="purchase_request_rfq.group_purchase_request_manager"
                            data-hotkey="z"/>
                    <button name="action_open_reject" string="Reject" type="object"
                            invisible="state != 'to_approve'"
                            groups="purchase_request_rfq.group_purchase_request_manager"/>
                    <button name="action_open_make_rfq" string="Create RFQ" type="object"
                            class="oe_highlight" invisible="state not in ('approved', 'rfq_created')"
                            groups="purchase.group_purchase_user" data-hotkey="q"/>
                    <button name="%(purchase_request_rfq.action_report_purchase_request)d"
                            string="Print" type="action" groups="base.group_user" data-hotkey="k"/>
                    <button name="action_reset_draft" string="Set to Draft" type="object"
                            invisible="state not in ('rejected', 'cancelled')" data-hotkey="o"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'to_approve', 'approved')"
                            data-hotkey="x"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,to_approve,approved,rfq_created"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_rfqs" type="object" class="oe_stat_button"
                                icon="fa-shopping-cart" invisible="rfq_count == 0">
                            <field name="rfq_count" widget="statinfo" string="RFQs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <span class="o_form_label">Purchase Request</span>
                        <h1 class="d-flex align-items-center gap-2">
                            <field name="priority" widget="priority" readonly="state in ('rfq_created', 'cancelled')"/>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" widget="res_partner_many2one"
                                   context="{'res_partner_search_mode': 'supplier', 'show_vat': True}"
                                   placeholder="Optional - can be chosen when creating the RFQ"
                                   readonly="state in ('rfq_created', 'rejected', 'cancelled')"/>
                            <field name="partner_ref"
                                   readonly="state in ('rfq_created', 'rejected', 'cancelled')"/>
                            <field name="currency_id" groups="base.group_multi_currency"
                                   readonly="state != 'draft'"/>
                            <field name="requester_id" widget="many2one_avatar_user"
                                   readonly="state != 'draft'"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_request" readonly="state != 'draft'"/>
                            <field name="date_required"
                                   readonly="state in ('rfq_created', 'rejected', 'cancelled')"/>
                            <field name="payment_term_id" options="{'no_create': True}"
                                   readonly="state in ('rfq_created', 'rejected', 'cancelled')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products" name="products">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list string="Purchase Request Lines" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="company_id" column_invisible="True"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="product_id" placeholder="Select a Product"
                                           context="{'quantity': product_qty, 'company_id': parent.company_id}"
                                           domain="[('purchase_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"/>
                                    <field name="description" placeholder="Enter a Description..."/>
                                    <field name="date_planned" optional="hide"/>
                                    <field name="analytic_distribution" widget="analytic_distribution"
                                           groups="analytic.group_analytic_accounting"
                                           options="{'product_field': 'product_id', 'business_domain': 'purchase_order', 'amount_field': 'subtotal'}"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id" groups="uom.group_uom"
                                           options="{'no_create': True}"/>
                                    <field name="price_unit"/>
                                    <field name="tax_ids" widget="many2many_tax_tags"
                                           options="{'no_create': True}" optional="show"
                                           domain="[('type_tax_use', '=', 'purchase'), ('company_id', '=', parent.company_id)]"/>
                                    <field name="subtotal"/>
                                </list>
                            </field>
                            <group>
                                <group>
                                    <field colspan="2" name="note" nolabel="1"
                                           placeholder="Define your terms and conditions ..."
                                           readonly="state in ('rfq_created', 'rejected', 'cancelled')"/>
                                </group>
                                <group class="oe_subtotal_footer border-top-0">
                                    <field name="amount_untaxed"/>
                                    <field name="amount_tax"/>
                                    <field name="amount_total" class="oe_subtotal_footer_separator"/>
                                </group>
                            </group>
                            <div class="clearfix"/>
                        </page>
                        <page string="Other Information" name="other_info">
                            <group>
                                <group name="buyer_info">
                                    <field name="user_id" widget="many2one_avatar_user"
                                           readonly="state in ('rfq_created', 'rejected', 'cancelled')"/>
                                    <field name="origin"
                                           readonly="state in ('rfq_created', 'rejected', 'cancelled')"/>
                                    <field name="company_id" groups="base.group_multi_company"
                                           readonly="state != 'draft'"/>
                                </group>
                                <group name="approval_info">
                                    <field name="approver_id" widget="many2one_avatar_user"
                                           invisible="not approver_id"/>
                                    <field name="decision_date" invisible="not decision_date"/>
                                    <field name="rejection_reason" invisible="not rejection_reason"/>
                                </group>
                            </group>
                            <group string="Justification">
                                <field name="reason" nolabel="1"
                                       placeholder="Why is this needed?"
                                       readonly="state != 'draft'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="purchase_request_view_search" model="ir.ui.view">
        <field name="name">purchase.request.search</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <search string="Search Purchase Requests">
                <field name="name" string="Reference"/>
                <field name="requester_id"/>
                <field name="partner_id"/>
                <field name="origin"/>
                <field name="line_ids" string="Product" filter_domain="[('line_ids.product_id', 'ilike', self)]"/>
                <filter name="my_requests" string="My Requests"
                        domain="[('requester_id', '=', uid)]"/>
                <filter name="urgent" string="Urgent" domain="[('priority', '=', '1')]"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="to_approve" string="To Approve"
                        domain="[('state', '=', 'to_approve')]"/>
                <filter name="approved" string="Approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter name="rfq_created" string="RFQ Created"
                        domain="[('state', '=', 'rfq_created')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_requester" string="Requester"
                            context="{'group_by': 'requester_id'}"/>
                    <filter name="group_vendor" string="Vendor"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_date" string="Request Date"
                            context="{'group_by': 'date_request:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="purchase_request_action" model="ir.actions.act_window">
        <field name="name">Purchase Requests</field>
        <field name="res_model">purchase.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first purchase request</p>
            <p>Request products, get them approved, then turn them into RFQs.</p>
        </field>
    </record>

    <record id="purchase_request_action_approval" model="ir.actions.act_window">
        <field name="name">Requests to Approve</field>
        <field name="res_model">purchase.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_approve': 1}</field>
    </record>
</odoo>
