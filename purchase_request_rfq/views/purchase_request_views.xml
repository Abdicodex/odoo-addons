<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_request_view_list" model="ir.ui.view">
        <field name="name">purchase.request.list</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <list string="Purchase Requisitions" decoration-info="state == 'to_approve'"
                  decoration-muted="state in ('cancelled', 'rejected')">
                <field name="name" string="PRF"/>
                <field name="date_request" widget="date"/>
                <field name="requester_id" widget="many2one_avatar_user"/>
                <field name="department_id" optional="show"/>
                <field name="project_id" optional="show"/>
                <field name="budget_id" optional="hide"/>
                <field name="fund_id" optional="hide"/>
                <field name="approver_id" widget="many2one_avatar_user" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="amount_total" sum="Total" widget="monetary"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'to_approve'"
                       decoration-success="state in ('approved', 'rfq_created')"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="purchase_request_view_form" model="ir.ui.view">
        <field name="name">purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <form string="Purchase Requisition">
                <header>
                    <button name="action_request_approval" string="Request Approval" type="object"
                            class="oe_highlight" invisible="state != 'draft'" data-hotkey="g"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="oe_highlight" invisible="state != 'to_approve'"
                            data-hotkey="z"/>
                    <button name="action_open_reject" string="Reject" type="object"
                            invisible="state != 'to_approve'"/>
                    <button name="action_open_make_rfq" string="Create RFQ" type="object"
                            class="oe_highlight" invisible="state not in ('approved', 'rfq_created')"
                            groups="purchase.group_purchase_user" data-hotkey="q"/>
                    <button name="%(purchase_request_rfq.action_report_purchase_request)d"
                            string="Print" type="action" groups="base.group_user" data-hotkey="k"/>
                    <button name="action_reset_draft" string="Set to Draft" type="object"
                            invisible="state not in ('rejected', 'cancelled')" data-hotkey="o"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'to_approve', 'approved')"
                            data-hotkey="x"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,to_approve,approved,rfq_created"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_rfqs" type="object" class="oe_stat_button"
                                icon="fa-shopping-cart" invisible="rfq_count == 0">
                            <field name="rfq_count" widget="statinfo" string="RFQs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <span class="o_form_label">Purchase Requisition Form</span>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group name="date_group">
                            <field name="date_request" widget="date" readonly="state != 'draft'"/>
                        </group>
                        <group name="company_group">
                            <field name="currency_id" groups="base.group_multi_currency"
                                   readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <separator string="Requisition Details"/>
                    <group>
                        <group name="requestor_details">
                            <!-- name, position, department and email come from the user record -->
                            <field name="requester_id" widget="many2one_avatar_user"
                                   options="{'no_open': True}"/>
                            <field name="requester_position"/>
                            <field name="department_id" options="{'no_open': True}"/>
                            <field name="location_id" required="1" readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="requester_email"/>
                        </group>
                        <group name="funding_details">
                            <field name="project_id" required="1" readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="budget_id" required="1"
                                   readonly="state != 'draft' or not project_id"
                                   placeholder="Select the category..."
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="budget_code"/>
                            <field name="fund_id" required="1" readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="verifier_id" widget="many2one_avatar_user"
                                   readonly="state != 'draft'" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <separator string="Item Details"/>
                    <field name="line_ids" nolabel="1" readonly="state != 'draft'">
                        <list string="Items" editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="company_id" column_invisible="True"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="item_no" string="Item #"/>
                            <field name="description" required="1"
                                   placeholder="Describe the item or service..."/>
                            <field name="unit"/>
                            <field name="product_qty" string="Quantity"/>
                            <field name="frequency"/>
                            <field name="price_unit"/>
                            <field name="subtotal" string="Amount" sum="Total Amount"/>
                            <field name="product_id" optional="hide"
                                   options="{'no_create': True}"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="amount_total" class="oe_subtotal_footer_separator"/>
                    </group>
                    <div class="clearfix"/>
                    <separator string="Approval"/>
                    <group>
                        <group name="approver_block">
                            <field name="approver_id" widget="many2one_avatar_user"
                                   readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="approver_position"/>
                            <field name="approval_date" invisible="not approval_date"/>
                        </group>
                        <group name="second_signatory_block">
                            <field name="second_signatory_id" widget="many2one_avatar_user"
                                   readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="second_position" invisible="not second_signatory_id"/>
                            <field name="second_approval_date" invisible="not second_approval_date"/>
                        </group>
                    </group>
                    <group invisible="not rejection_reason">
                        <field name="decision_by_id" string="Rejected By"/>
                        <field name="rejection_reason"/>
                    </group>
                    <group string="Remarks">
                        <field name="reason" nolabel="1" readonly="state != 'draft'"
                               placeholder="Any extra remarks..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="purchase_request_view_search" model="ir.ui.view">
        <field name="name">purchase.request.search</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <search string="Search Requisitions">
                <field name="name" string="PRF"/>
                <field name="requester_id"/>
                <field name="project_id"/>
                <field name="budget_id"/>
                <field name="fund_id"/>
                <field name="department_id"/>
                <field name="line_ids" string="Item" filter_domain="[('line_ids.description', 'ilike', self)]"/>
                <filter name="my_requests" string="My Requisitions"
                        domain="[('requester_id', '=', uid)]"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="to_approve" string="To Approve"
                        domain="[('state', '=', 'to_approve')]"/>
                <filter name="approved" string="Approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter name="rfq_created" string="RFQ Created"
                        domain="[('state', '=', 'rfq_created')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_requester" string="Requestor"
                            context="{'group_by': 'requester_id'}"/>
                    <filter name="group_project" string="Project"
                            context="{'group_by': 'project_id'}"/>
                    <filter name="group_department" string="Department"
                            context="{'group_by': 'department_id'}"/>
                    <filter name="group_fund" string="Fund" context="{'group_by': 'fund_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date_request:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="purchase_request_action" model="ir.actions.act_window">
        <field name="name">Requisitions</field>
        <field name="res_model">purchase.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first purchase requisition</p>
            <p>Raise a requisition, get it approved, then turn it into RFQs.</p>
        </field>
    </record>

    <record id="purchase_request_action_approval" model="ir.actions.act_window">
        <field name="name">Awaiting My Approval</field>
        <field name="res_model">purchase.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'to_approve'), '|', ('approver_id', '=', uid), ('second_signatory_id', '=', uid)]</field>
    </record>
</odoo>
