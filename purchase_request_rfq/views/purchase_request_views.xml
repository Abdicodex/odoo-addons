<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_request_view_list" model="ir.ui.view">
        <field name="name">purchase.request.list</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'to_approve'" decoration-success="state == 'approved'"
                  decoration-muted="state in ('cancelled', 'rejected')">
                <field name="name"/>
                <field name="requester_id" widget="many2one_avatar_user"/>
                <field name="date_required"/>
                <field name="estimated_total" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="purchase_request_view_form" model="ir.ui.view">
        <field name="name">purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit for Approval" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary"
                            invisible="state != 'to_approve'"
                            groups="purchase_request_rfq.group_purchase_request_manager"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'to_approve'"
                            groups="purchase_request_rfq.group_purchase_request_manager"/>
                    <button name="action_open_make_rfq" string="Create RFQ" type="object"
                            class="btn-primary" invisible="state not in ('approved', 'rfq_created')"
                            groups="purchase.group_purchase_user"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('rejected', 'cancelled')"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('cancelled', 'rfq_created')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,to_approve,approved,rfq_created"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_view_rfqs" type="object" class="oe_stat_button"
                                icon="fa-shopping-cart" invisible="rfq_count == 0">
                            <field name="rfq_count" widget="statinfo" string="RFQs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="requester_id" readonly="state != 'draft'"/>
                            <field name="date_required" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                            <field name="approver_id" invisible="not approver_id"/>
                            <field name="decision_date" invisible="not decision_date"/>
                            <field name="currency_id" invisible="True"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description" optional="show"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id" groups="uom.group_uom"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal" sum="Total"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="estimated_total"/>
                            </group>
                        </page>
                        <page string="Reason" name="reason">
                            <field name="reason" readonly="state != 'draft'"
                                   placeholder="Why is this needed?"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="purchase_request_view_search" model="ir.ui.view">
        <field name="name">purchase.request.search</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="requester_id"/>
                <filter name="my_requests" string="My Requests"
                        domain="[('requester_id', '=', uid)]"/>
                <filter name="to_approve" string="To Approve"
                        domain="[('state', '=', 'to_approve')]"/>
                <filter name="approved" string="Approved"
                        domain="[('state', '=', 'approved')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_requester" string="Requester"
                            context="{'group_by': 'requester_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="purchase_request_action" model="ir.actions.act_window">
        <field name="name">Purchase Requests</field>
        <field name="res_model">purchase.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_requests': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first purchase request</p>
            <p>Request products, get them approved, then turn them into RFQs.</p>
        </field>
    </record>

    <record id="purchase_request_action_approval" model="ir.actions.act_window">
        <field name="name">Requests to Approve</field>
        <field name="res_model">purchase.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_approve': 1}</field>
    </record>
</odoo>
