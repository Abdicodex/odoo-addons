<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hijra_budget_view_list_rfq_product" model="ir.ui.view">
        <field name="name">hijra.budget.list.rfq.product</field>
        <field name="model">hijra.budget</field>
        <field name="inherit_id" ref="hijra_base.hijra_budget_view_list"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="purchase_product_id" options="{'no_create': True}" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
