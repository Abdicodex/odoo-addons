<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_request_make_rfq_view_form" model="ir.ui.view">
        <field name="name">purchase.request.make.rfq.form</field>
        <field name="model">purchase.request.make.rfq</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="request_id"/>
                        <field name="subject"/>
                        <field name="partner_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="deadline"/>
                        <field name="validity_days"/>
                    </group>
                </group>
                <group>
                    <field name="quotation_details" placeholder="One item per line, e.g. company registration certificate"/>
                </group>
                <separator string="Products for the RFQ"/>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="request_line_id" column_invisible="True" force_save="1"/>
                        <field name="item_no" string="Item #"/>
                        <field name="description"/>
                        <field name="quantity"/>
                        <field name="product_id" placeholder="Default product" options="{'no_create': True}"/>
                    </list>
                </field>
                <footer>
                    <button name="action_create_rfqs" string="Create RFQs" type="object"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="purchase_request_reject_view_form" model="ir.ui.view">
        <field name="name">purchase.request.reject.form</field>
        <field name="model">purchase.request.reject</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="request_id"/>
                    <field name="reason" placeholder="Why is this requisition rejected?"/>
                </group>
                <footer>
                    <button name="action_reject" string="Reject" type="object"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
