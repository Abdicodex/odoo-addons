<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="rule_purchase_request_own" model="ir.rule">
        <field name="name">Purchase Request: requesters see their own</field>
        <field name="model_id" ref="model_purchase_request"/>
        <field name="domain_force">[('requester_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_purchase_request_user'))]"/>
    </record>

    <record id="rule_purchase_request_all" model="ir.rule">
        <field name="name">Purchase Request: approvers and buyers see all</field>
        <field name="model_id" ref="model_purchase_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_purchase_request_manager')), (4, ref('purchase.group_purchase_user'))]"/>
    </record>

    <record id="rule_purchase_request_company" model="ir.rule">
        <field name="name">Purchase Request: multi-company</field>
        <field name="model_id" ref="model_purchase_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
