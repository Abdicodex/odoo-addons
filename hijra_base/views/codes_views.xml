<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Funds -->
    <record id="hijra_fund_view_list" model="ir.ui.view">
        <field name="name">hijra.fund.list</field>
        <field name="model">hijra.fund</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="hijra_fund_action" model="ir.actions.act_window">
        <field name="name">Funds</field>
        <field name="res_model">hijra.fund</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Locations -->
    <record id="hijra_location_view_list" model="ir.ui.view">
        <field name="name">hijra.location.list</field>
        <field name="model">hijra.location</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="hijra_location_action" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">hijra.location</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_hijra_codes_root"
              name="HIJRA Codes"
              sequence="90"
              groups="group_hijra_codes_manager,base.group_system"/>
    <menuitem id="menu_hijra_fund" name="Funds" parent="menu_hijra_codes_root"
              action="hijra_fund_action" sequence="30"/>
    <menuitem id="menu_hijra_location" name="Locations" parent="menu_hijra_codes_root"
              action="hijra_location_action" sequence="40"/>
</odoo>
