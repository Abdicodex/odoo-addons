<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Employee profile (HR) -->
    <record id="hr_employee_view_form_hijra_signature" model="ir.ui.view">
        <field name="name">hr.employee.form.hijra.signature</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='work_information']" position="after">
                <page name="hijra_signature" string="Signature">
                    <group>
                        <field name="hijra_signature" widget="image" options="{'size': [400, 160]}"/>
                    </group>
                    <p class="text-muted">
                        Printed on the documents this employee signs (requisitions, and later
                        timesheets, payslips and more). Use a clear PNG with a transparent background.
                    </p>
                </page>
            </xpath>
        </field>
    </record>

    <!-- My Preferences (self service) -->
    <record id="res_users_view_form_preferences_hijra_signature" model="ir.ui.view">
        <field name="name">res.users.preferences.form.hijra.signature</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="hr.res_users_view_form_preferences"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='private_information']" position="after">
                <page name="hijra_signature" string="Signature">
                    <group>
                        <field name="hijra_signature" widget="image" options="{'size': [400, 160]}"/>
                    </group>
                    <p class="text-muted">
                        Printed on the documents you sign (requisitions, and later timesheets,
                        payslips and more). Use a clear PNG with a transparent background.
                    </p>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
